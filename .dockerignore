# Allowlist: the build context contains only what the production image needs.
# Everything else (local tooling such as .claude/ or .idea/, .env* files, tests,
# docs, vendor/, var/) never reaches the image. Add new paths here deliberately.
*

!bin/
!config/
!docker/frankenphp/
!migrations/
!public/
!src/
!composer.json
!composer.lock
!symfony.lock
!.env

# Never ship the production decryption key; provide it at runtime instead.
config/secrets/*/*.decrypt.private.php
public/bundles/
**/.DS_Store
**/.gitignore
