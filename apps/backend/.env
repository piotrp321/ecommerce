# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Connection parameters are passed separately (no DSN), so the password may contain
# any character without URL encoding. Development defaults only.
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=app
DATABASE_USER=app
DATABASE_PASSWORD='!ChangeMe!'
DATABASE_SERVER_VERSION=18
###< doctrine/doctrine-bundle ###

###> OpenID Connect (ADR-0005) ###
# Access tokens of the identity provider (Keycloak), validated statelessly with the
# keys from OIDC discovery. Per realm:
# - ISSUER: the exact "iss" of the tokens (the public address of the realm),
# - DISCOVERY_URL: where the backend reads the discovery document and the keys
#   (inside the Compose network; must end with a slash),
# - AUDIENCE: the required "aud" (the API client of the realm),
# - CLIENTS: the clients allowed to call the API ("azp"), separated by commas.
# Development defaults only; production sets them as runtime variables.
OIDC_STORE_ISSUER=http://localhost:8180/realms/store
OIDC_STORE_DISCOVERY_URL=http://keycloak:8080/realms/store/
OIDC_STORE_AUDIENCE=store-api
OIDC_STORE_CLIENTS=store-bff
OIDC_ADMIN_ISSUER=http://localhost:8180/realms/admin
OIDC_ADMIN_DISCOVERY_URL=http://keycloak:8080/realms/admin/
OIDC_ADMIN_AUDIENCE=admin-api
OIDC_ADMIN_CLIENTS=admin-bff
###< OpenID Connect ###
